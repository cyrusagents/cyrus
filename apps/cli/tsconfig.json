{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"miko-core": ["../../packages/core/src"],
			"miko-claude-runner": ["../../packages/claude-runner/src"],
			"miko-simple-agent-runner": ["../../packages/simple-agent-runner/src"],
