{
	"name": "miko",
	"version": "0.2.72",
	"description": "Self-hosted development agent for Linear, GitHub, GitLab, Slack and Zulip",
	"main": "dist/src/app.js",
	"types": "dist/src/app.d.ts",
	"bin": {
		"miko": "./dist/src/app.js"
	},
	"type": "module",
	"scripts": {
		"build": "tsgo",
		"start": "node dist/src/app.js",
		"dev": "tsgo --watch",
		"test": "vitest run",
		"test:run": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"typecheck": "tsgo --noEmit",
		"prepublishOnly": "cd ../.. && pnpm build"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mikoagents/miko.git",
		"directory": "apps/cli"
	},
	"keywords": [
		"linear",
		"claude",
		"ai",
		"automation",
		"cli"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@linear/sdk": "^64.0.0",
		"@sentry/node": "^10.65.0",
		"commander": "^14.0.2",
		"miko-claude-runner": "workspace:*",
		"miko-cloudflare-tunnel-client": "workspace:*",
		"miko-config-updater": "workspace:*",
		"miko-core": "workspace:*",
		"miko-edge-worker": "workspace:*",
		"miko-slack-event-transport": "workspace:*",
		"dotenv": "^16.5.0",
		"express": "^5.2.1",
		"fastify": "^5.12.1",
		"file-type": "^21.0.0",
		"fs-extra": "^11.3.0",
		"node-fetch": "^2.7.0",
		"open": "^10.0.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@vitest/ui": "^4.1.11",
		"nodemon": "^3.1.14",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.11"
	}
}
