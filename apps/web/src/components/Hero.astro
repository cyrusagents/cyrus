---
import MikoBadge from "./MikoBadge.astro";
import SlackDemo from "./SlackDemo.astro";
---

<section id="hero">
  <div class="mx-auto flex w-full max-w-[var(--site-content-width)] flex-col items-center gap-12 px-4 pt-32 pb-20 text-center sm:gap-16 sm:px-6 sm:pt-[148px] sm:pb-28">
    <div class="flex w-full min-w-0 flex-col items-center">
      <div class="hero-heading">
        <img class="hero-logo" src="/assets/avatars/miko.jpg" width="120" height="120" alt="Miko" />
        <h1 class="font-display w-full min-w-0 max-w-4xl text-4xl leading-[1.05] tracking-tight text-balance sm:text-5xl lg:text-6xl">
          Self-hosted AI coding agent for Slack, Linear and GitHub
        </h1>
      </div>
      <p
        class="text-theme-text-muted mt-4 w-full min-w-0 max-w-xl text-base leading-relaxed text-pretty sm:mt-5 sm:max-w-2xl sm:text-lg sm:leading-relaxed"
      >
        Bring Claude Code, Codex, or Cursor to Linear, GitHub, GitLab, and Slack. Assign an issue to Miko or just <MikoBadge />. Get progress, answers, and pull requests back in your workflow.
      </p>
      <div
        class="mt-6 sm:mt-7"
        style="opacity: 1; filter: blur(0px); transform: none;"
      >
        <div class="flex flex-col items-center gap-3">
          <div class="flex items-center justify-center gap-2 md:gap-3">
            <a
              class="inline-flex items-center justify-center rounded-full transition-colors bg-theme-accent hover:bg-theme-accent-hover text-theme-accent-contrast h-9 gap-1.5 px-4 text-sm font-normal md:h-11 md:px-6 md:text-base"

              href="#get-started"
            >
              Get started
            </a>
            <a
              class="inline-flex items-center justify-center rounded-full transition-colors bg-theme-card-03-hex text-theme-text transition-colors duration-200 ease-out hover:bg-theme-fg-10 h-9 gap-1.5 px-4 text-sm font-normal md:h-11 md:px-6 md:text-base"
              href="https://github.com/mikoagents/miko"
              target="_blank"
              rel="me noopener noreferrer"
            >
              View on GitHub
            </a>
          </div>
        </div>
      </div>
    </div>
    <SlackDemo />
  </div>
</section>
