---
import MikoBadge from "./MikoBadge.astro";
const tasks = [
	{ title: "Webhook fix", branch: "fix/webhooks", tone: "violet" },
	{ title: "Dark mode", branch: "feat/dark-mode", tone: "teal" },
	{ title: "Setup docs", branch: "docs/setup", tone: "ochre" },
];
---

<section id="features">
  <div class="mx-auto w-full px-4 lg:px-6 xl:max-w-7xl flex flex-col gap-10 py-20 sm:py-28 lg:gap-14">
    <div class="mx-auto flex max-w-2xl flex-col gap-4 text-center">
      <h2 class="font-display text-3xl tracking-tight text-balance sm:text-4xl">
        Put Miko to work on your code
      </h2>
      <p class="text-primary text-base leading-relaxed text-pretty sm:text-lg sm:leading-relaxed">
        Hand off an issue, @mention Miko, or put the work on a schedule. Your coding agent investigates, implements, and checks it in its own workspace, then brings the result back for review.
      </p>
    </div>
    <div class="grid gap-5 sm:grid-cols-2">
      <article class="bg-card flex flex-col overflow-hidden rounded-3xl p-6 sm:p-8">
        <h3 class="text-primary text-base leading-relaxed font-medium text-pretty">
          Give Miko a task where you work
        </h3>
        <p class="text-primary text-base leading-relaxed text-pretty">
          Assign a Linear issue or @mention Miko in a connected conversation. It picks up the task and repository context so your coding agent can get started.
        </p>
        <figure class="mt-auto pt-8" aria-label="Example: a Slack mention hands a webhook bug to Miko">
  <div class="feature-card-stage"><div class="feature-card-snippet">
    <div class="miko-feature-diagram handoff-diagram">
      <div class="handoff-request">
        <span class="handoff-channel"><img src="/assets/integrations/slack.webp" alt="Slack" width="22" height="22" /> <span># engineering</span></span>
        <p class="diagram-bubble"><MikoBadge /> Fix duplicate webhooks.</p>
      </div>
      <div class="handoff-connector" aria-hidden="true"><span></span><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3"><path d="m4 6 4 4 4-4"/></svg></div>
      <div class="handoff-received"><span class="handoff-identity"><span class="miko-feature-avatar"><img class="avatar-photo avatar-photo--miko" src="/assets/avatars/miko.jpg" alt="" /></span><strong>Miko</strong></span><span class="handoff-action">Picking up your task</span><span class="handoff-working"><span class="capsule-dot" aria-hidden="true"></span>Working</span></div>
      <div class="handoff-context"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 5a2 2 0 0 1 2-2h11v14H5a2 2 0 0 1-2-2V5Zm0 10a2 2 0 0 1 2-2h11M6 6h7M6 9h5"/></svg> Your conversation + your repository</div>
    </div>
  </div></div>
</figure>
      </article>
      <article class="bg-card flex flex-col overflow-hidden rounded-3xl p-6 sm:p-8">
        <h3 class="text-primary text-base leading-relaxed font-medium text-pretty">
          Keep each task in its own workspace
        </h3>
        <p class="text-primary text-base leading-relaxed text-pretty">
          Miko creates a separate Git worktree for each task. A bug fix, a feature, and a documentation update can move forward without mixing their changes.
        </p>
        <figure class="mt-auto pt-8" aria-label="One repository branches into three isolated task workspaces: webhook fix, dark mode, and setup docs">
  <div class="feature-card-stage"><div class="feature-card-snippet">
    <div class="miko-feature-diagram isolation-diagram">
      <div class="repo-root"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M3 5a2 2 0 0 1 2-2h11v14H5a2 2 0 0 1-2-2V5Zm0 10a2 2 0 0 1 2-2h11"/></svg>Your repository</div>
      <div class="workspace-branches">
        {tasks.map(task => <div class:list={["isolated-task", task.tone]}>
          <span class="branch-node" aria-hidden="true"></span>
          <div class="isolated-task-body"><span class="task-title">{task.title}</span><span class="task-branch"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><circle cx="4" cy="3" r="1.5"/><circle cx="4" cy="13" r="1.5"/><circle cx="12" cy="4" r="1.5"/><path d="M4 4.5v7m8-6A5 5 0 0 1 7 10H4"/></svg>{task.branch}</span><span class="task-running" aria-label="Running"><span></span><span></span><span></span></span></div>
        </div>)}
      </div>
      <div class="isolation-caption">Separate changes. Moving in parallel.</div>
    </div>
  </div></div>
</figure>
      </article>
      <article class="bg-card flex flex-col overflow-hidden rounded-3xl p-6 sm:p-8">
        <h3 class="text-primary text-base leading-relaxed font-medium text-pretty">
          Change the brief with a reply
        </h3>
        <p class="text-primary text-base leading-relaxed text-pretty">
          Forgot an edge case? Add it to the conversation. Miko picks up your follow-up and continues the same task with its existing context.
        </p>
        <figure class="mt-auto pt-8" aria-label="Example: you add a test requirement and Miko continues the same task">
  <div class="feature-card-stage"><div class="feature-card-snippet">
    <div class="miko-feature-diagram followup-diagram">
      <div class="followup-user"><span class="diagram-speaker">You</span><p class="diagram-bubble">Also test empty payloads.</p></div>
      <div class="followup-agent"><span class="diagram-speaker agent-speaker"><span class="miko-feature-avatar"><img class="avatar-photo avatar-photo--miko" src="/assets/avatars/miko.jpg" alt="" /></span> Miko</span><p class="diagram-bubble">On it. Adding that case to the webhook fix.</p></div>
      <div class="diagram-status"><span class="continuation-line" aria-hidden="true">↳</span><span>Same task</span><span class="task-capsule">Webhook fix <span class="capsule-dot" aria-hidden="true"></span> Working</span></div>
    </div>
  </div></div>
</figure>
      </article>
      <article class="bg-card flex flex-col overflow-hidden rounded-3xl p-6 sm:p-8">
        <h3 class="text-primary text-base leading-relaxed font-medium text-pretty">
          Get a pull request back
        </h3>
        <p class="text-primary text-base leading-relaxed text-pretty">
          Miko writes the code, runs the configured checks, and opens a pull request with a summary. You review the changes and decide what ships.
        </p>
        <figure class="mt-auto pt-8" aria-label="Example delivery: a pull request with changed files and passing checks, ready for your review">
  <div class="feature-card-stage"><div class="feature-card-snippet">
    <div class="miko-feature-diagram delivery-diagram">
      <div class="delivery-progress"><span><i aria-hidden="true">✓</i> Implemented</span><span class="progress-connector" aria-hidden="true"></span><span><i aria-hidden="true">✓</i> Tested</span><span class="progress-connector" aria-hidden="true"></span><span><i aria-hidden="true">✓</i> PR opened</span></div>
      <div class="delivery-bubble">
        <svg class="delivery-pr-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="6" cy="5" r="2.5"/><circle cx="6" cy="19" r="2.5"/><circle cx="18" cy="19" r="2.5"/><path d="M6 7.5v9M18 16.5V8a3 3 0 0 0-3-3h-3m3-3-3 3 3 3"/></svg>
        <div class="delivery-detail"><strong>Fix duplicate webhooks</strong><span>3 files changed <b class="diff-add">+42</b> <b class="diff-remove">−8</b></span></div>
        <span class="delivery-check" aria-label="Checks passed">✓</span>
      </div>
      <div class="diagram-status"><span class="miko-feature-avatar"><img class="avatar-photo avatar-photo--miko" src="/assets/avatars/miko.jpg" alt="" /></span><span class="review-capsule">Ready for your review</span></div>
    </div>
  </div></div>
</figure>
      </article>
      <article class="bg-card flex flex-col overflow-hidden rounded-3xl p-6 sm:p-8">
        <h3 class="text-primary text-base leading-relaxed font-medium text-pretty">
          Put work on a schedule
        </h3>
        <p class="text-primary text-base leading-relaxed text-pretty">
          Choose when it runs: a single time, every day, weekly, or a cron schedule. At that time Miko does the task and brings the result back for review.
        </p>
        <figure class="mt-auto pt-8" aria-label="Every day at 09:00, Miko reviews pull requests and the work is ready for review. The same run happens again tomorrow at 09:00.">
          <div class="feature-card-stage"><div class="feature-card-snippet">
            <div class="miko-feature-diagram schedule-diagram">
              <div class="schedule-fire">
                <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="10" cy="10" r="7.25"/><path d="M10 6v4.2l2.4 1.5"/></svg>
                <strong>09:00</strong>
                <span>Every day</span>
              </div>
              <div class="schedule-link" aria-hidden="true"><span></span></div>
              <div class="schedule-outcome">
                <div class="schedule-task"><span class="miko-feature-avatar"><img class="avatar-photo avatar-photo--miko" src="/assets/avatars/miko.jpg" alt="" /></span><strong>Miko</strong><span>Review pull requests</span></div>
                <div class="schedule-ready"><i aria-hidden="true">✓</i> Ready for your review</div>
              </div>
              <p class="schedule-again">Again tomorrow at 09:00</p>
            </div>
          </div></div>
        </figure>
      </article>
      <article class="bg-card flex flex-col overflow-hidden rounded-3xl p-6 sm:p-8">
        <h3 class="text-primary text-base leading-relaxed font-medium text-pretty">
          Read it on your board
        </h3>
        <p class="text-primary text-base leading-relaxed text-pretty">
          Select the task on the local board. Its tool calls, checks, and final result stay there for you to read.
        </p>
        <figure class="mt-auto pt-8" aria-label="The local board for Fix duplicate webhooks shows a file read, a passing test, and a result ready for review">
          <div class="feature-card-stage"><div class="feature-card-snippet">
            <div class="miko-feature-diagram board-story">
              <div class="board-story-task"><strong>Fix duplicate webhooks</strong><span>Turn completed</span></div>
              <div class="board-story-log">
                <span><b>Read</b> handler.ts</span>
                <span><b>Test</b> 28 passed</span>
                <span><b>Result</b> Ready for review</span>
              </div>
            </div>
          </div></div>
        </figure>
      </article>
    </div>
  </div>
</section>

<style>
  .miko-feature-diagram { display:flex; flex-direction:column; justify-content:center; gap:12px; min-height:200px; width:100%; max-width:460px; margin:auto; color:var(--color-theme-text); font-size:14px; line-height:1.45; }
  .diagram-speaker { display:flex; align-items:center; gap:5px; color:var(--color-theme-text-muted); font-size:11px; margin-bottom:5px; }
  .followup-user { align-self:flex-end; max-width:85%; }
  .followup-user .diagram-speaker { justify-content:flex-end; }
  .followup-agent { align-self:flex-start; max-width:92%; }
  .diagram-bubble { margin:0; padding:11px 15px; border-radius:16px; background:color-mix(in srgb,var(--color-theme-text) 5%,var(--color-theme-bg)); }
  .followup-user .diagram-bubble { border-bottom-right-radius:5px; }
  .followup-agent .diagram-bubble { border-bottom-left-radius:5px; }
  .miko-feature-avatar { display:inline-flex; flex:none; width:20px; height:20px; overflow:hidden; border-radius:50%; }
  .diagram-status { display:flex; align-items:center; justify-content:center; gap:7px; flex-wrap:wrap; font-size:12px; color:var(--color-theme-text-muted); }
  .task-capsule, .review-capsule { display:inline-flex; align-items:center; gap:7px; padding:4px 9px; border-radius:30px; background:color-mix(in srgb,#885cf5 12%,var(--color-theme-bg)); color:color-mix(in srgb,#885cf5 78%,var(--color-theme-text)); font-size:11px; }
  .capsule-dot { width:4px; height:4px; background:currentColor; border-radius:50%; }
  .continuation-line { font-size:18px; }
  .delivery-diagram { gap:23px; }
  .delivery-progress { display:flex; align-items:center; justify-content:center; gap:9px; font-size:11px; color:var(--color-theme-text-muted); }
  .delivery-progress > span:not(.progress-connector) { white-space:nowrap; }
  .delivery-progress i { font-style:normal; color:#65a68d; margin-right:3px; }
  .progress-connector { height:1px; width:22px; background:var(--color-theme-border); }
  .delivery-bubble { display:flex; align-items:center; gap:14px; padding:20px; border-radius:18px; background:color-mix(in srgb,var(--color-theme-text) 5%,var(--color-theme-bg)); }
  .delivery-pr-icon { flex:none; width:26px; height:26px; color:#885cf5; }
  .delivery-detail { display:flex; flex-direction:column; gap:6px; }
  .delivery-detail strong { font-size:14px; font-weight:500; }
  .delivery-detail > span { font-size:11px; color:var(--color-theme-text-muted); }
  .delivery-detail b { font-weight:500; margin-left:6px; }
  .diff-add { color:#57967b; } .diff-remove { color:#b97373; }
  .delivery-check { margin-left:auto; color:#65a68d; }
  @media(max-width:479px) { .delivery-progress { gap:6px; font-size:10px; } .progress-connector { width:12px; } .delivery-bubble { padding:16px 12px; gap:10px; } .delivery-detail strong { font-size:13px; } .miko-feature-diagram { font-size:13px; } }

  .handoff-diagram { gap:0; max-width:400px; }
  .handoff-request { width:100%; }
  .handoff-channel { display:flex; align-items:center; gap:7px; font-size:11px; color:var(--color-theme-text-muted); margin:0 0 8px 8px; }
  .handoff-channel img { width:22px; height:22px; }
  .handoff-request .diagram-bubble { padding:14px 18px; }
  .handoff-connector { display:flex; flex-direction:column; align-items:center; height:31px; color:var(--color-theme-text-muted); opacity:.55; }
  .handoff-connector span { height:18px; width:1px; background:currentColor; }
  .handoff-connector svg { width:16px; height:16px; margin-top:-7px; }
  .handoff-received { display:flex; align-items:center; gap:9px; padding:13px 16px; border-radius:30px; background:color-mix(in srgb,#885cf5 9%,var(--color-theme-bg)); }
  .handoff-identity { display:flex; align-items:center; gap:5px; }
  .handoff-identity strong { font-size:12px; font-weight:500; }
  .handoff-action { font-size:11px; color:var(--color-theme-text-muted); }
  .handoff-working { display:flex; align-items:center; gap:5px; margin-left:auto; font-size:10px; color:#885cf5; }
  .handoff-context { display:flex; align-items:center; justify-content:center; gap:5px; margin-top:14px; color:var(--color-theme-text-muted); font-size:11px; }
  .handoff-context svg, .repo-root svg { height:14px; width:14px; }
  .isolation-diagram { gap:0; max-width:410px; }
  .repo-root { display:flex; align-items:center; gap:6px; font-size:12px; margin:0 0 9px 0; }
  .workspace-branches { padding-left:24px; }
  .isolated-task { position:relative; padding:4px 0 4px 22px; border-left:1px solid var(--color-theme-border); }
  .isolated-task::before { content:""; position:absolute; left:0; top:50%; width:21px; height:1px; background:var(--color-theme-border); }
  .isolated-task:last-child { border-left-color:transparent; }
  .isolated-task:last-child::after { content:""; position:absolute; left:-1px; top:0; height:50%; width:1px; background:var(--color-theme-border); }
  .branch-node { position:absolute; left:18px; top:calc(50% - 3px); width:6px; height:6px; border-radius:50%; background:var(--branch-color); z-index:1; }
  .isolated-task-body { display:flex; align-items:center; gap:10px; padding:11px 13px; border-radius:13px; background:color-mix(in srgb,var(--branch-color) 8%,var(--color-theme-bg)); }
  .violet { --branch-color:#885cf5; } .teal { --branch-color:#54a792; } .ochre { --branch-color:#c59448; }
  .task-title { font-size:12px; min-width:82px; }
  .task-branch { display:flex; align-items:center; gap:4px; color:var(--color-theme-text-muted); font-size:10px; }
  .task-branch svg { width:13px; height:13px; flex:none; color:var(--branch-color); }
  .task-running { display:flex; gap:3px; margin-left:auto; }
  .task-running span { width:3px; height:3px; border-radius:50%; background:var(--branch-color); }
  .task-running span:nth-child(2) { opacity:.6; } .task-running span:last-child { opacity:.3; }
  .isolation-caption { font-size:11px; color:var(--color-theme-text-muted); text-align:center; margin-top:10px; }
  .miko-feature-diagram.schedule-diagram { gap:0; max-width:400px; min-height:0; }
  .schedule-fire { display:flex; align-items:center; justify-content:center; gap:8px; padding:11px 16px; border-radius:16px; background:color-mix(in srgb,var(--color-theme-text) 5%,var(--color-theme-bg)); }
  .schedule-fire svg { width:16px; height:16px; flex:none; color:var(--color-theme-text-muted); }
  .schedule-fire strong { font-size:20px; font-weight:500; letter-spacing:-.04em; line-height:1; font-variant-numeric:tabular-nums; }
  .schedule-fire span { font-size:11px; color:var(--color-theme-text-muted); }
  .schedule-link { display:flex; justify-content:center; height:22px; color:var(--color-theme-text-muted); opacity:.55; }
  .schedule-link span { width:1px; height:22px; background:currentColor; }
  .schedule-outcome { display:flex; flex-direction:column; gap:8px; padding:13px 14px; border-radius:18px; background:color-mix(in srgb,#885cf5 9%,var(--color-theme-bg)); }
  .schedule-task { display:flex; align-items:center; gap:7px; min-width:0; font-size:12px; }
  .schedule-task strong { font-weight:500; }
  .schedule-task span:last-child { color:var(--color-theme-text-muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .schedule-ready { display:flex; align-items:center; gap:6px; font-size:12px; color:#57967b; }
  .schedule-ready i { font-style:normal; }
  .schedule-again { margin:10px 0 0; text-align:center; font-size:11px; color:var(--color-theme-text-muted); }
  .miko-feature-diagram.board-story { gap:8px; max-width:400px; min-height:0; }
  .board-story-task { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:12px 14px; border-radius:14px; background:color-mix(in srgb,#885cf5 9%,var(--color-theme-bg)); font-size:12px; }
  .board-story-task strong { font-weight:500; }
  .board-story-task span { flex:none; font-size:10px; color:#57967b; }
  .board-story-log { display:flex; flex-direction:column; gap:6px; }
  .board-story-log span { display:flex; align-items:center; gap:8px; padding:8px 12px; border-radius:12px; background:color-mix(in srgb,var(--color-theme-text) 5%,var(--color-theme-bg)); font-size:12px; }
  .board-story-log b { flex:none; min-width:42px; font-size:10px; font-weight:500; color:var(--color-theme-text-muted); }
  @media(max-width:479px) {
    .handoff-received { padding:12px; gap:7px; flex-wrap:wrap; }
    .handoff-action { font-size:10px; }
    .workspace-branches { padding-left:9px; }
    .isolated-task { padding-left:15px; }
    .isolated-task::before { width:14px; }
    .branch-node { left:12px; }
    .isolated-task-body { padding:10px; gap:6px; }
    .task-title { min-width:70px; font-size:11px; }
    .task-branch { font-size:9px; }
    .task-running { display:none; }
    .schedule-fire { padding:9px 12px; }
    .schedule-fire strong { font-size:18px; }
    .schedule-outcome { padding:11px 12px; }
    .schedule-again { margin-top:8px; }
    .board-story-task { padding:10px 12px; }
    .board-story-log span { padding:6px 10px; }
  }
</style>
