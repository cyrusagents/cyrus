---
import MikoBadge from "./MikoBadge.astro";
import { faqs } from "../data/site";
---

<section id="faqs">
  <div class="mx-auto grid w-full max-w-[var(--site-content-width)] gap-10 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-2 lg:gap-16">
    <h2 class="lg:sticky lg:top-8 lg:self-start font-display text-3xl tracking-tight text-balance sm:text-4xl">
      FAQs
    </h2>
    <div class="divide-border border-border divide-y border-b">
      {faqs.map((item, index) => {
        const open = index === 0;
        const buttonId = `faq-${index}-button`;
        const panelId = `faq-${index}-panel`;
        return (
          <div>
            <h3 class="m-0 text-base font-normal">
              <button
                aria-controls={panelId}
                aria-expanded={open ? "true" : "false"}
                class="focus-visible:ring-primary/30 flex w-full items-start justify-between gap-6 py-5 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
                id={buttonId}
                type="button"
              >
                <span class="text-primary text-base font-medium leading-6">{item.question}</span>
                <svg
                  aria-hidden="true"
                  class:list={[
                    "text-primary/60 mt-0.5 size-5 shrink-0 transition-transform duration-200",
                    { "rotate-45": open },
                  ]}
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-width="1.5"
                  viewBox="0 0 20 20"
                >
                  <path d="M10 4v12M4 10h12"></path>
                </svg>
              </button>
            </h3>
            <div
              aria-labelledby={buttonId}
              class="overflow-hidden"
              id={panelId}
              inert={open ? undefined : true}
              role="region"
              style={open ? "height: auto; opacity: 1;" : "height: 0px; opacity: 0;"}
            >
              <div class="text-primary max-w-2xl pr-11 pb-6 text-base leading-7 [&_p+p]:mt-3 [&_a]:text-primary/80 [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-primary">
                <p>
                  {item.answer.split("@Miko").map((part, partIndex) => (
                    <>
                      {partIndex > 0 && <MikoBadge />}
                      {part}
                    </>
                  ))}
                </p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
