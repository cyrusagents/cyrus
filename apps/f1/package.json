{
	"name": "cyrus-f1",
	"version": "0.1.0",
	"type": "module",
	"description": "F1 Testing Framework CLI for Cyrus",
	"main": "dist/src/cli.js",
	"types": "dist/src/cli.d.ts",
	"bin": {
		"f1": "./f1"
	},
	"scripts": {
		"build": "tsc",
		"start": "bun run dist/src/cli.js",
		"server": "bun run server.ts",
		"server:dev": "bun --watch server.ts",
		"router-server": "node --env-file-if-exists=.env dist/router-server.js",
		"dev": "tsc --watch",
		"test": "vitest",
		"test:run": "vitest run --passWithNoTests",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "cd ../.. && pnpm build"
	},
	"files": [
		"dist",
		"f1",
		"server.ts",
		"router-server.ts",
		"README.md",
		"CLAUDE.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"commander": "^14.0.3",
		"cyrus-claude-runner": "workspace:*",
		"cyrus-core": "workspace:*",
		"cyrus-edge-worker": "workspace:*",
		"cyrus-router": "workspace:*",
		"cyrus-router-executors": "workspace:*",
		"cyrus-slack-event-transport": "workspace:*",
		"fastify": "^5.12.1"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11",
		"cyrus-ai": "workspace:*",
		"cyrus-operator-protocol": "workspace:*",
		"cyrus-router-client": "workspace:*"
	},
	"engines": {
		"node": ">=18.0.0"
	}
}
