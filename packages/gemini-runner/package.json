{
	"name": "atmiko-gemini-runner",
	"version": "0.2.72",
	"description": "Gemini CLI process spawning and management for Atmiko",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nexmoe/atmiko.git",
		"directory": "packages/gemini-runner"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsgo && cp -r src/prompts dist/prompts",
		"dev": "tsgo --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@linear/sdk": "^60.0.0",
		"atmiko-claude-runner": "workspace:*",
		"atmiko-core": "workspace:*",
		"atmiko-simple-agent-runner": "workspace:*",
		"dotenv": "^16.6.1",
		"fs-extra": "^11.3.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^20.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"access": "public"
	}
}
