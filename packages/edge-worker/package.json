{
	"name": "miko-edge-worker",
	"version": "0.2.72",
	"description": "Unified edge worker for processing Linear issues with Claude",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mikoagents/miko.git",
		"directory": "packages/edge-worker"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"prompt-template-v2.md",
		"prompt-template.md",
		"label-prompt-template.md",
		"prompts"
	],
	"scripts": {
		"build": "tsgo && npm run copy-prompts && npm run build:board",
		"copy-prompts": "cp label-prompt-template.md dist/ && cp -r prompts dist/ && rm -rf dist/miko-skills-plugin && cp -rL miko-skills-plugin dist/miko-skills-plugin",
		"dev": "tsgo --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"typecheck": "tsgo --noEmit",
		"build:board": "node scripts/build-board.mjs"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.268",
		"@linear/sdk": "^64.0.0",
		"@ngrok/ngrok": "^1.5.1",
		"miko-claude-runner": "workspace:*",
		"miko-cloudflare-tunnel-client": "workspace:*",
		"miko-codex-runner": "workspace:*",
		"miko-config-updater": "workspace:*",
		"miko-core": "workspace:*",
		"miko-cursor-runner": "workspace:*",
		"miko-gemini-runner": "workspace:*",
		"miko-github-event-transport": "workspace:*",
		"miko-gitlab-event-transport": "workspace:*",
		"miko-linear-event-transport": "workspace:*",
		"miko-mcp-tools": "workspace:*",
		"miko-opencode-runner": "workspace:*",
		"miko-simple-agent-runner": "workspace:*",
		"miko-slack-event-transport": "workspace:*",
		"miko-zulip-event-transport": "workspace:*",
		"chokidar": "^4.0.3",
		"cron-parser": "^5.10.1",
		"fastify": "^5.12.1",
		"fastify-mcp": "^2.1.0",
		"file-type": "^21.3.2",
		"ignore": "^7.0.5",
		"node-forge": "^1.4.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@hugeicons/core-free-icons": "4.3.3",
		"@hugeicons/react": "1.1.10",
		"@melloware/react-logviewer": "6.5.5",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tabs": "^1.1.21",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^20.0.0",
		"@types/node-forge": "^1.3.14",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/coverage-v8": "^4.1.11",
		"axios": "^1.18.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"esbuild": "^0.28.2",
		"framer-motion": "^13.4.1",
		"lucide-react": "^1.47.0",
		"postcss": "^8.5.28",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"vitest": "^4.1.11",
		"vitest-mock-extended": "^3.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
