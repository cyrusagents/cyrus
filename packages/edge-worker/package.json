{
	"name": "atmiko-edge-worker",
	"version": "0.2.72",
	"description": "Unified edge worker for processing Linear issues with Claude",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nexmoe/atmiko.git",
		"directory": "packages/edge-worker"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist",
		"prompt-template-v2.md",
		"prompt-template.md",
		"label-prompt-template.md",
		"prompts"
	],
	"scripts": {
		"build": "tsgo && npm run copy-prompts && npm run build:board",
		"copy-prompts": "cp label-prompt-template.md dist/ && cp -r prompts dist/ && rm -rf dist/atmiko-skills-plugin && cp -rL atmiko-skills-plugin dist/atmiko-skills-plugin",
		"dev": "tsgo --watch",
		"test": "vitest",
		"test:run": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"typecheck": "tsgo --noEmit",
		"build:board": "node scripts/build-board.mjs"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.268",
		"@linear/sdk": "^64.0.0",
		"@ngrok/ngrok": "^1.5.1",
		"chokidar": "^4.0.3",
		"atmiko-claude-runner": "workspace:*",
		"atmiko-cloudflare-tunnel-client": "workspace:*",
		"atmiko-codex-runner": "workspace:*",
		"atmiko-config-updater": "workspace:*",
		"atmiko-core": "workspace:*",
		"atmiko-cursor-runner": "workspace:*",
		"atmiko-gemini-runner": "workspace:*",
		"atmiko-github-event-transport": "workspace:*",
		"atmiko-gitlab-event-transport": "workspace:*",
		"atmiko-linear-event-transport": "workspace:*",
		"atmiko-mcp-tools": "workspace:*",
		"atmiko-opencode-runner": "workspace:*",
		"atmiko-simple-agent-runner": "workspace:*",
		"atmiko-slack-event-transport": "workspace:*",
		"atmiko-zulip-event-transport": "workspace:*",
		"fastify": "^5.12.1",
		"fastify-mcp": "^2.1.0",
		"file-type": "^21.3.2",
		"ignore": "^7.0.5",
		"node-forge": "^1.4.0",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@hugeicons/core-free-icons": "4.3.3",
		"@hugeicons/react": "1.1.10",
		"@melloware/react-logviewer": "6.5.5",
		"@types/node": "^20.0.0",
		"@types/node-forge": "^1.3.14",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vitest/coverage-v8": "^4.1.11",
		"axios": "^1.18.0",
		"esbuild": "^0.28.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"vitest": "^4.1.11",
		"vitest-mock-extended": "^3.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
