{
	"name": "cyrus-github-event-transport",
	"version": "0.2.72",
	"description": "GitHub event transport for receiving and verifying forwarded GitHub webhooks",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyrusagents/cyrus.git",
		"directory": "packages/github-event-transport"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsgo",
		"dev": "tsgo --watch",
