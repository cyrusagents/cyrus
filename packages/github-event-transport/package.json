		"test:run": "vitest run"
	},
	"dependencies": {
		"cyrus-core": "workspace:*",
		"fastify": "^5.12.1"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"access": "public"
	}
}
