{
	"name": "cyrus-simple-agent-runner",
	"version": "0.2.72",
	"description": "Simple agent runner for enumerated responses",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyrusagents/cyrus.git",
		"directory": "packages/simple-agent-runner"
	},
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsgo",
		"dev": "tsgo --watch",
		"test": "vitest",
		"test:run": "vitest run --passWithNoTests",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.268",
		"cyrus-claude-runner": "workspace:*",
		"cyrus-core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vitest": "^4.1.11"
	},
	"publishConfig": {
		"access": "public"
	}
}
