{
	"compilerOptions": {
		"target": "ES2022",
		"types": ["node"],
		"module": "NodeNext",
		"lib": ["ES2022"],
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"strict": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"paths": {
			"miko-core": ["./packages/core"],
			"miko-claude-parser": ["./packages/claude-parser"],
			"miko-linear-client": ["./packages/linear-client"],
			"miko-history-stream": ["./packages/history-stream"],
			"miko-edge-worker": ["./packages/edge-worker"],
			"miko-claude-runner": ["./packages/claude-runner"],
			"miko-codex-runner": ["./packages/codex-runner"],
			"miko-cursor-runner": ["./packages/cursor-runner"],
			"miko-gemini-runner": ["./packages/gemini-runner"],
			"miko-mcp-tools": ["./packages/mcp-tools"],
			"miko-simple-agent-runner": ["./packages/simple-agent-runner"],
			"miko-config-updater": ["./packages/config-updater"],
			"miko-linear-event-transport": ["./packages/linear-event-transport"]
		}
	},
	"exclude": ["node_modules", "dist", "build"]
}
